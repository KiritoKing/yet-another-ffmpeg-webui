{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FFmpeg Easy",
  "version": "0.1.0",
  "identifier": "com.ffmpeg.easy",
  "build": {
    "frontendDist": "../build/client",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "FFmpeg Easy",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
